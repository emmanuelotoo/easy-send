# --- Where the app lives ----------------------------------------------------
# The exact address you open the app at. Passkeys are tied to this hostname,
# and anything other than localhost must be https://.
APP_ORIGIN=http://localhost:3000
PORT=3000

# One-time code for pairing a device (creating its passkey).
# Generate one with: openssl rand -hex 16
# After your devices are paired you can remove it to lock enrollment.
SETUP_CODE=

# --- Paystack -----------------------------------------------------------------
# Use sk_test_... while trying things out.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Your own MoMo number and email, used when the app tops up your Paystack
# balance from your wallet (Paystack's Charge API requires an email).
OWNER_PHONE=024XXXXXXX
OWNER_EMAIL=you@example.com

# Pull the shortfall from your MoMo wallet when the Paystack balance is too low.
# Costs Paystack's 1.95% collection fee and needs "manual payouts" enabled on
# your Paystack account. Set to false to simply refuse the send instead.
AUTO_FUND=true

# --- Limits (GHS) ---------------------------------------------------------------
DAILY_LIMIT_GHS=500
PER_TRANSACTION_LIMIT_GHS=200
LOW_BALANCE_ALERT_GHS=50

# --- Misc -----------------------------------------------------------------------
# Where the SQLite database is kept.
DATA_DIR=data
# debug, info, warn, error
LOG_LEVEL=info
