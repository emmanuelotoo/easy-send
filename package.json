{
  "name": "easy-send",
  "version": "1.0.0",
  "description": "Send Ghana mobile money in two taps: a personal PWA on top of Paystack.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "demo": "tsx scripts/demo.ts",
    "build": "tsup src/index.ts --format cjs --clean && node -e \"require('fs').cpSync('src/db/migrations','dist/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmanuelotoo/easy-send.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/emmanuelotoo/easy-send/issues"
  },
  "homepage": "https://github.com/emmanuelotoo/easy-send#readme",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@simplewebauthn/server": "^13.3.3",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.0",
    "fastify": "^5.12.8",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
